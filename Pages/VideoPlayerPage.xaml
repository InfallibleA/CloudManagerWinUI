<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CloudManagerWinUIApp.Pages.VideoPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CloudManagerWinUIApp.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Button
                x:Name="BackButton"
                AutomationProperties.Name="{x:Bind L.Back}"
                Click="Back_Click"
                ToolTipService.ToolTip="{x:Bind L.Back}">
                <FontIcon FontSize="16" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                x:Name="TitleText"
                Style="{StaticResource TitleTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
            <ProgressRing
                x:Name="BusyRing"
                Width="20"
                Height="20"
                IsActive="False"
                VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1">
            <MediaPlayerElement
                x:Name="Player"
                AreTransportControlsEnabled="True"
                AutomationProperties.Name="{x:Bind L.Video}"
                AutoPlay="True"
                Stretch="Uniform" />

            <InfoBar
                x:Name="ErrorBar"
                VerticalAlignment="Bottom"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />
        </Grid>
    </Grid>
</Page>
