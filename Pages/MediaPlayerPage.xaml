<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CloudManagerWinUIApp.Pages.MediaPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CloudManagerWinUIApp.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Button
                x:Name="BackButton"
                AutomationProperties.AutomationId="MediaPlayerBackButton"
                AutomationProperties.Name="{x:Bind L.Back}"
                Click="Back_Click"
                ToolTipService.ToolTip="{x:Bind L.Back}">
                <FontIcon FontSize="16" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                x:Name="TitleText"
                Style="{StaticResource TitleTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
            <ProgressRing
                x:Name="BusyRing"
                Width="20"
                Height="20"
                IsActive="False"
                VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                x:Name="AudioCard"
                Grid.Row="0"
                MaxWidth="560"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" Spacing="16">
                    <Border
                        Width="96"
                        Height="96"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <FontIcon
                            FontSize="48"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE8D6;"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <TextBlock
                        x:Name="AudioTrackTitle"
                        MaxLines="2"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <MediaPlayerElement
                x:Name="Player"
                Grid.Row="0"
                Grid.RowSpan="2"
                AreTransportControlsEnabled="True"
                AutomationProperties.AutomationId="MediaPlayerControl"
                AutomationProperties.Name="{x:Bind L.Video}"
                AutoPlay="True"
                Stretch="Uniform">
                <MediaPlayerElement.TransportControls>
                    <MediaTransportControls x:Name="TransportControls" />
                </MediaPlayerElement.TransportControls>
            </MediaPlayerElement>

            <InfoBar
                x:Name="ErrorBar"
                Grid.Row="0"
                Grid.RowSpan="2"
                VerticalAlignment="Bottom"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />
        </Grid>
    </Grid>
</Page>
