<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CloudManagerWinUIApp.Pages.TextViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CloudManagerWinUIApp.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BackButton"
                AutomationProperties.Name="{x:Bind L.Back}"
                Click="Back_Click"
                ToolTipService.ToolTip="{x:Bind L.Back}">
                <FontIcon FontSize="16" Glyph="&#xE72B;" />
            </Button>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="12"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="TitleText"
                    Style="{StaticResource TitleTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
                <ProgressRing
                    x:Name="BusyRing"
                    Width="20"
                    Height="20"
                    IsActive="False"
                    VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <ToggleButton
                    x:Name="WrapToggle"
                    AutomationProperties.Name="{x:Bind L.WordWrap}"
                    Click="WrapToggle_Click"
                    IsChecked="True"
                    ToolTipService.ToolTip="{x:Bind L.WordWrap}">
                    <FontIcon FontSize="16" Glyph="&#xE8E4;" />
                </ToggleButton>

                <Button
                    x:Name="CopyButton"
                    AutomationProperties.Name="{x:Bind L.Copy}"
                    Click="Copy_Click"
                    IsEnabled="False"
                    ToolTipService.ToolTip="{x:Bind L.Copy}">
                    <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                </Button>

                <Button
                    x:Name="DownloadButton"
                    AutomationProperties.Name="{x:Bind L.Download}"
                    Click="Download_Click"
                    ToolTipService.ToolTip="{x:Bind L.Download}">
                    <FontIcon FontSize="16" Glyph="&#xE896;" />
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False" />

        <TextBox
            x:Name="ContentBox"
            Grid.Row="2"
            AcceptsReturn="True"
            FontFamily="Cascadia Mono, Consolas, Courier New"
            FontSize="13"
            IsReadOnly="True"
            Padding="12"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            TextWrapping="Wrap" />
    </Grid>
</Page>
