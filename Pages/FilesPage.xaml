<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CloudManagerWinUIApp.Pages.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CloudManagerWinUIApp.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind L.FilesTab}" />
            <ProgressRing
                x:Name="BusyRing"
                Width="20"
                Height="20"
                IsActive="False"
                IsIndeterminate="True"
                VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1">
            <!-- Пользователь не авторизован -->
            <StackPanel
                x:Name="AuthRequiredPanel"
                MaxWidth="680"
                HorizontalAlignment="Left"
                Spacing="16"
                VerticalAlignment="Top">
                <InfoBar
                    IsClosable="False"
                    IsOpen="True"
                    Message="{x:Bind L.FilesAuthMessage}"
                    Severity="Informational"
                    Title="{x:Bind L.FilesAuthTitle}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        AutomationProperties.Name="{x:Bind L.SignInToAccount}"
                        Click="SignIn_Click"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE77B;" />
                            <TextBlock Text="{x:Bind L.SignIn}" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="{x:Bind L.Register}" Click="Register_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8FA;" />
                            <TextBlock Text="{x:Bind L.Register}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Содержимое -->
            <Grid
                x:Name="FilesRoot"
                RowSpacing="12"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <BreadcrumbBar
                        x:Name="FolderBreadcrumb"
                        VerticalAlignment="Center"
                        ItemClicked="FolderBreadcrumb_ItemClicked" />

                    <Button
                        x:Name="AddButton"
                        Grid.Column="1"
                        AutomationProperties.Name="{x:Bind L.AddEntryAutomation}"
                        Style="{StaticResource AccentButtonStyle}">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Click="AddFolder_Click" Text="{x:Bind L.Folder}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="AddFile_Click" Text="{x:Bind L.File}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7C3;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="AddVideo_Click" Text="{x:Bind L.Video}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE714;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="{x:Bind L.AddEntry}" />
                            <FontIcon FontSize="10" Glyph="&#xE70D;" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ProgressBar
                    x:Name="UploadProgress"
                    Grid.Row="1"
                    Visibility="Collapsed" />

                <Grid Grid.Row="2">
                    <GridView
                        x:Name="ItemsGrid"
                        IsItemClickEnabled="True"
                        ItemClick="ItemsGrid_ItemClick"
                        SelectionMode="None">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid
                                    ItemHeight="128"
                                    ItemWidth="128"
                                    Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:ExplorerItem">
                                <Grid
                                    Width="128"
                                    Height="128"
                                    Padding="8,4,8,8"
                                    AutomationProperties.Name="{x:Bind AutomationName}"
                                    Background="Transparent"
                                    ContextRequested="Item_ContextRequested"
                                    RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <FontIcon
                                        FontSize="56"
                                        Foreground="{x:Bind IconBrush}"
                                        Glyph="{x:Bind Glyph}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Grid.Row="1"
                                        FontSize="12"
                                        MaxLines="2"
                                        Text="{x:Bind Name}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <TextBlock
                        x:Name="EmptyText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind L.NothingHere}"
                        Visibility="Collapsed" />

                    <TextBlock
                        x:Name="NoRootText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind L.NoRootFolder}"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>

            <InfoBar
                x:Name="ErrorBar"
                VerticalAlignment="Bottom"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />
        </Grid>
    </Grid>
</Page>
