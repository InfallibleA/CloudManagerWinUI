{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug x64 (CloudManagerWinUIApp.exe)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build (x64 Debug)",
      "program": "${workspaceFolder}/bin/x64/Debug/net10.0-windows10.0.26100.0/win-x64/CloudManagerWinUIApp.exe",
      "args": [],
      "cwd": "${workspaceFolder}/bin/x64/Debug/net10.0-windows10.0.26100.0/win-x64",
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": true,
      "requireExactSource": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Debug x64 Release (.exe)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build (x64 Release)",
      "program": "${workspaceFolder}/bin/x64/Release/net10.0-windows10.0.26100.0/win-x64/CloudManagerWinUIApp.exe",
      "args": [],
      "cwd": "${workspaceFolder}/bin/x64/Release/net10.0-windows10.0.26100.0/win-x64",
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": true,
      "requireExactSource": false
    },
    {
      "name": "Attach (CloudManagerWinUIApp)",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "justMyCode": true,
      "requireExactSource": false
    }
  ]
}
