<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CloudManagerWinUIApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CloudManagerWinUIApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="CloudManager"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="CloudManager"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>

            <!-- Кнопка авторизации — рядом с системными кнопками окна. -->
            <TitleBar.RightHeader>
                <StackPanel Margin="0,0,8,0" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="SignInButton"
                        AutomationProperties.Name="Войти в аккаунт"
                        Click="SignInButton_Click"
                        ToolTipService.ToolTip="Войти или зарегистрироваться">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE77B;" />
                            <TextBlock x:Name="SignInText" Text="Войти" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="AccountButton"
                        AutomationProperties.Name="Аккаунт"
                        Visibility="Collapsed"
                        ToolTipService.ToolTip="Аккаунт">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE77B;" />
                            <TextBlock x:Name="AccountLoginText" Text="Пользователь" />
                            <FontIcon FontSize="10" Glyph="&#xE70D;" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem
                                    AutomationProperties.Name="Выйти из аккаунта"
                                    Click="SignOutItem_Click"
                                    Text="Выйти">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7E8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="NewsNavItem"
                    Content="Новости"
                    IsSelected="True"
                    Tag="news">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE789;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="FilesNavItem" Content="Файлы" Tag="files">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- Виден только пользователю с ролью admin (см. UpdateAuthUi). -->
                <NavigationViewItem
                    x:Name="AdminNavItem"
                    Content="Админ-панель"
                    Tag="admin"
                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7EF;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AboutNavItem" Content="О программе" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA3A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="NavFrame" Navigated="NavFrame_Navigated" />
        </NavigationView>

        <!--
            Баннер принудительного выхода: аккаунт заблокирован администратором.
            Лежит во второй строке поверх контента, скрыт по умолчанию (см. UpdateAuthUi).
        -->
        <InfoBar
            x:Name="BlockedBar"
            Grid.Row="1"
            Margin="12,8,12,0"
            VerticalAlignment="Top"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />
    </Grid>
</Window>
